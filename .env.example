# Acceso actual: usuario y contraseña, sin Gmail ni verificación por correo.
EXPENSA_AUTH_MODE=password
# Primero ejecutar: .venv/Scripts/python.exe scripts/crear_administradora.py
# El modo email es opcional futuro y requiere configurar SMTP.
# Copy the required values into .env on the server. Never commit .env.
EXPENSA_ADMIN_EMAIL=admin@example.com
# Real HTTPS address of this installation (no trailing slash).
EXPENSA_PUBLIC_URL=
EXPENSA_ALLOWED_ORIGINS=
# SMTP delivery must use SSL or STARTTLS. Use a dedicated sender credential.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Endpoint autorizado compatible con ratoneando-go (/api/search). Sin configurar: solo ofertas guardadas.
RATONEANDO_API_URL=
# Idiomas instalados en Tesseract, por ejemplo spa+eng.
TESSERACT_LANG=eng
TESSERACT_CMD=

# Opcional: carpeta privada de imágenes; por defecto data/receipts. Respaldar junto a la base.
# EXPENSA_RECEIPT_DIR=/ruta/privada/persistente/receipts
