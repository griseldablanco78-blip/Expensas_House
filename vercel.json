{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci && npm run build:web",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/web/vendor/**,tests/**,docs/**,scripts/**,output/**,TP_Integrador/**,.runtime/**}"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
